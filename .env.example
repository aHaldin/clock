# Generate private values with npm run setup:env. Never commit actual secrets.
ADMIN_PASSWORD_HASH=
PIN_PEPPER=
# Netlify supplies NETLIFY_DB_URL after provisioning its database.
# For a separate/local PostgreSQL database, set DATABASE_URL instead.
DATABASE_URL=
BROWSER_CLOCKING=true
# Only enable certificate-free HTTP loopback during local development:
LOCAL_CLOCKING=false
# Optional exact application origin, e.g. https://your-site.netlify.app
APP_ORIGIN=

ANY_DEVICE_CLOCKING=true
