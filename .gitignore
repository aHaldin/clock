/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
!.env.example
.dev.vars*
*.key
*.p12
*.pfx
/deployment/wrangler.gateway.local.jsonc
*.sql.backup

# Legacy local Cloudflare setup stays on this laptop; not shipped to Netlify.
/.openai/
/build/
/vendor/
/examples/
/db/
/drizzle.config.ts
/vite.config.ts
/cloudflare-env.d.ts
*.tsbuildinfo
/.netlify/
/scripts/*
!/scripts/setup-env.mjs
!/scripts/migrate.mjs
/tests/http-smoke.mjs

